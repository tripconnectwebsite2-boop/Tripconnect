# ==============================================================================
# TRIP CONNECT - ENVIRONMENT VARIABLES SPECIFICATION
# Copy this file to `.env.local` for local development.
# Configure these variables in Vercel / Cloud hosting for production deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# Used for sitemap.xml, Schema.org JSON-LD canonical URLs, and email link generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# If left empty, the application gracefully operates in local resilient JSON store
# mode (.data/db.json) with full CRUD and seed data initialized.
# For production, obtain these credentials from your Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ------------------------------------------------------------------------------
# 3. STRICT ADMIN ALLOWLIST AUTHENTICATION
# ------------------------------------------------------------------------------
# The administrator email address authorized to access the Admin CRM,
# package management, and customer lead records.
ADMIN_ALLOWED_EMAIL="tripconnectwebsite2@gmail.com"

# ------------------------------------------------------------------------------
# 3b. FIREBASE GOOGLE AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from Firebase Console > Project Settings > General > Your Apps (Web).
# Ensure "Google" is enabled in Firebase Console > Authentication > Sign-in method,
# and "localhost" is added to Authentication > Settings > Authorized Domains.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyC6STcc6a82EIrg7apay8QdsH24HobiTRw"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="trip-connect-versel.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="trip-connect-versel"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="trip-connect-versel.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="913300034921"
NEXT_PUBLIC_FIREBASE_APP_ID="1:913300034921:web:fafe1ed1ed98337b4a99f8"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-JCLBN6BTYC"

# ------------------------------------------------------------------------------
# 4. EMAIL NOTIFICATIONS (RESEND ADAPTER)
# ------------------------------------------------------------------------------
# Used to dispatch instant enquiry notifications to the Trip Connect concierge team.
# Leave blank during local testing to log simulated email payloads to the console.
RESEND_API_KEY=""
CONTACT_EMAIL="tripconnectwebsite2@gmail.com"
NOTIFICATION_EMAIL_FROM="onboarding@resend.dev"
NOTIFICATION_EMAIL_TO="tripconnectwebsite2@gmail.com"

# ------------------------------------------------------------------------------
# 5. WHATSAPP CONCIERGE INTEGRATION
# ------------------------------------------------------------------------------
# Official Trip Connect Kerala customer support WhatsApp number (E.164 without '+').
NEXT_PUBLIC_WHATSAPP_PHONE="919400886838"

# WhatsApp Cloud API (optional, for automated transactional WhatsApp templates):
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
