rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Central Trip Connect Store (Website Content, Packages, Destinations, Settings)
    // Allows public read and updates for Next.js website & admin sync
    // Strictly forbids deletion so the website database cannot be erased
    match /tripconnect/{docId} {
      allow read, write: if true;
      allow delete: if false;
    }

    // 2. Customer Enquiries (Customer PII Protection)
    // Public can submit booking enquiries
    // Reading, updating, or deleting customer phone numbers/details is locked to admin only
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';

      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';
      }
    }

    // 3. Bug Reports
    match /bugs/{bugId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';
    }

    // 4. Default Deny - Blocks unauthorized access to all other paths
    // Eliminates the Firebase public database security warning
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
