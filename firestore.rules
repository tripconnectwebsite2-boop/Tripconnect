rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Central Trip Connect Store (Website Content, Packages, Destinations, Settings)
    // Allows public read so visitors can browse packages and site pages.
    // Allows updates up to 2MB for seamless admin panel sync.
    // Strictly forbids deletion so the website database cannot be erased.
    match /tripconnect/{docId} {
      allow read: if true;
      allow write: if request.resource.size < 2097152;
      allow delete: if false;
    }

    // 2. Customer Enquiries (PII Protection)
    // Customers can submit enquiries from the website.
    // Reading, editing, or deleting enquiries is restricted to protect customer phone numbers and privacy.
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasAll(['customer_name', 'phone', 'email'])
                    && request.resource.data.customer_name is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';

      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';
      }
    }

    // 3. Standalone Public Collections (Packages, Destinations, Offers, Reviews)
    match /packages/{packageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';
    }

    match /destinations/{destId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';
    }

    // 4. Bug Reports
    match /bugs/{bugId} {
      allow create: if request.resource.data.keys().hasAll(['title', 'description']);
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'tripconnectwebsite2@gmail.com';
    }

    // 5. Default Deny - Completely blocks unauthorized access across the database
    // This removes the Firebase public warning and stops any unauthorized access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
